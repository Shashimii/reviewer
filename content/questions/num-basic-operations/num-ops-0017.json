  "id": "num-ops-0017",
  "topicId": "num-basic-operations",
  "skill": "ops-powers",
  "difficulty": 2,
  "stem": "What is 4 × 10⁴ + 7 × 10²?",
  "choices": [
    "4,700",
    "40,700",
    "47,000",
    "40,070"
  ],
  "answer": "40,700",
  "hints": [
    "A power of 10 is 1 followed by zeros. The exponent tells you how many zeros.",
    "Write 10⁴ and 10² as ordinary numbers.",
    "Multiply 4 by 10⁴ and 7 by 10², then add the two results."
  ],
  "solution": {
    "methodName": "Powers of 10: count the zeros",
    "steps": [
      {
        "action": "10⁴ is 1 followed by 4 zeros: 10,000.",
        "why": "10⁴ = 10 × 10 × 10 × 10. Each × 10 adds one zero."
      },
      {
        "action": "10² is 1 followed by 2 zeros: 100."
      },
      {
        "action": "Multiply: 4 × 10,000 = 40,000."
      },
      {
        "action": "Multiply: 7 × 100 = 700."
      },
      {
        "action": "Add: 40,000 + 700 = 40,700."
      },
      {
        "action": "The answer is 40,700."
      }
    ]
  },
  "trapNotes": {
    "4,700": "This uses 4 × 1,000 = 4,000. 10⁴ has 4 zeros, so 4 × 10⁴ = 40,000.",
    "47,000": "This puts the 7 in the thousands place, as if it were 7 × 10³. 7 × 10² = 700.",
    "40,070": "This uses 7 × 10 = 70. 10² has 2 zeros, so 7 × 10² = 700."
  },
